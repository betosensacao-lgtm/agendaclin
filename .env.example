# ---- Database (Supabase Postgres) ----
# Connection string com pooler (use a porta 6543 com ?pgbouncer=true em produção)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ---- Supabase (Auth + cliente browser/server) ----
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role só usar no servidor (RLS bypass) — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@agendaclin.app

# ---- Anti-spam (Cloudflare Turnstile) ----
TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...
