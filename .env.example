# ---- Database (Supabase Postgres) ----
# Pooler (transaction mode, porta 6543) — usar em runtime no Next.js/Vercel.
# Role app_runtime (RLS real, tenant-scoped — ver drizzle/migrations/
# 0002_real_tenant_rls.sql). NUNCA usar a role `postgres` aqui: ela tem
# BYPASSRLS=true e anula todo o isolamento entre clínicas.
DATABASE_URL=postgresql://app_runtime.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection (porta 5432) — usar em scripts CLI (seed, migrations).
# Essa sim usa a role admin (`postgres`), porque migrations precisam de
# DDL (CREATE POLICY, ALTER TABLE) que app_runtime não tem permissão pra fazer.
# Opcional: se ausente, scripts caem no pooler. Pooler tem problemas com
# prepared statements e timeouts em redes longe da região.
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Role app_cron — só o job de lembrete de WhatsApp (lib/db/cron.ts), com
# leitura cross-tenant (necessária pra varrer todas as clínicas) mas
# escrita restrita à coluna whatsapp_reminder_sent_at.
CRON_DATABASE_URL=postgresql://app_cron.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ---- Supabase (Auth + cliente browser/server) ----
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service role só usar no servidor (RLS bypass) — NUNCA expor no client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Email (Resend) ----
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@agendaclin.app

# ---- Anti-spam (Cloudflare Turnstile) ----
# NEXT_PUBLIC_ = exposto ao browser (site key); sem prefixo = só servidor (secret)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ---- WhatsApp (Z-API) ----
# Obter em: https://app.z-api.io → sua instância → "Token"
ZAPI_INSTANCE_ID=3D5AFE7AE57B3C86A25CA99F
ZAPI_TOKEN=seu-token-aqui
# Client-Token (se exigido pela instância — ver dashboard Z-API)
# ZAPI_CLIENT_TOKEN=

# ---- Cron Jobs (Vercel) ----
# Segredo que protege as rotas /api/cron/* de chamadas externas.
# Gere com: openssl rand -hex 32
CRON_SECRET=seu-cron-secret-aqui
